<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PiClock.ViewModels"
        xmlns:controls="using:PiClock.Controls"
        x:Class="PiClock.Views.MainWindow"
        Title="PiClock"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="Black">

    <Design.DataContext>
        <vm:ClockViewModel/>
    </Design.DataContext>

    <Panel Opacity="{Binding DisplayOpacity}">
    <Grid Margin="30,30">
        <Grid.RenderTransform>
            <TranslateTransform X="{Binding ShiftX}" Y="{Binding ShiftY}"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="74*"/>
            <ColumnDefinition Width="26*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════ LEFT: ANALOG CLOCK (analog + calendar modes) ════════════════════ -->
        <controls:AnalogClock Grid.Column="0" Margin="10,0,10,0"
                              Hours="{Binding CurrentHour}"
                              Minutes="{Binding CurrentMinute}"
                              Seconds="{Binding CurrentSecond}"
                              IsVisible="{Binding ShowAnalogClock}"/>

        <!-- ════════════════════ LEFT: DIGITAL CLOCK (digital mode) ════════════════════ -->
        <Grid Grid.Column="0" Margin="10,0,10,0"
              IsVisible="{Binding IsDigitalMode}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.28*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:SevenSegmentDigit Grid.Column="0" Digit="{Binding HourTens}"
                                        OnColor="White" Margin="5"/>
            <controls:SevenSegmentDigit Grid.Column="1" Digit="{Binding HourOnes}"
                                        OnColor="White" Margin="5"/>
            <controls:ColonDisplay      Grid.Column="2" IsOn="{Binding ColonVisible}"
                                        DotColor="White"/>
            <controls:SevenSegmentDigit Grid.Column="3" Digit="{Binding MinuteTens}"
                                        OnColor="White" Margin="5"/>
            <controls:SevenSegmentDigit Grid.Column="4" Digit="{Binding MinuteOnes}"
                                        OnColor="White" Margin="5"/>

            <!-- AM / PM — bottom-right of the time digits -->
            <TextBlock Grid.Column="5"
                       Text="{Binding AmPm}"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="SemiBold"
                       VerticalAlignment="Bottom"
                       Margin="12,0,0,8"/>
        </Grid>

        <!-- ════════════════════ RIGHT: CLEAN TEXT (analog mode) ════════════════════ -->
        <Grid Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center"
              IsVisible="{Binding IsAnalogMode}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Day of week — bold highway-sign text -->
            <Viewbox Grid.Row="0" Stretch="Uniform" Margin="18,0,18,4">
                <TextBlock Text="{Binding DayText}"
                           FontFamily="Inter"
                           FontWeight="ExtraBold"
                           Foreground="#5599FF"
                           LetterSpacing="2"/>
            </Viewbox>

            <!-- Month / Date — negative margin lets it stretch wider than the column padding -->
            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="-10,4,-10,0">
                <TextBlock Text="{Binding MonthDateText}"
                           FontFamily="Inter"
                           FontWeight="ExtraBold"
                           Foreground="#5599FF"/>
            </Viewbox>
        </Grid>

        <!-- ════════════════════ RIGHT: CALENDAR (calendar mode) ════════════════════ -->
        <controls:MonthCalendar Grid.Column="1" Margin="5,10,10,10"
                                Year="{Binding CurrentYear}"
                                Month="{Binding CurrentMonthNum}"
                                HighlightDay="{Binding CurrentDayNum}"
                                IsVisible="{Binding IsCalendarMode}"/>

        <!-- ════════════════════ RIGHT: SEGMENT DISPLAYS (digital mode) ════════════════════ -->
        <Grid Grid.Column="1" Margin="10,0,10,0"
              IsVisible="{Binding IsDigitalMode}">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Day of week — 16-segment characters -->
            <Grid Grid.Row="0" Margin="3,0,3,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <controls:SixteenSegmentChar Grid.Column="0" Char="{Binding DayChar1}"
                                              OnColor="#4040ff" Margin="2"/>
                <controls:SixteenSegmentChar Grid.Column="1" Char="{Binding DayChar2}"
                                              OnColor="#4040ff" Margin="2"/>
                <controls:SixteenSegmentChar Grid.Column="2" Char="{Binding DayChar3}"
                                              OnColor="#4040ff" Margin="2"/>
            </Grid>

            <!-- Month & Date — seven-segment digits -->
            <Grid Grid.Row="1" Margin="3,8,3,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <controls:SevenSegmentDigit Grid.Column="0" Digit="{Binding MonthTens}"
                                            OnColor="#4040ff" Margin="2"/>
                <controls:SevenSegmentDigit Grid.Column="1" Digit="{Binding MonthOnes}"
                                            OnColor="#4040ff" Margin="2"/>
                <!-- spacer column separates month from date -->
                <controls:SevenSegmentDigit Grid.Column="3" Digit="{Binding DateTens}"
                                            OnColor="#4040ff" Margin="2"/>
                <controls:SevenSegmentDigit Grid.Column="4" Digit="{Binding DateOnes}"
                                            OnColor="#4040ff" Margin="2"/>
            </Grid>
        </Grid>
    </Grid>

    <!-- 🐭 Scurrying mouse overlay -->
    <controls:RunningMouse IsHitTestVisible="False"/>
    </Panel>
</Window>
