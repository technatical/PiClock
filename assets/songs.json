{
  // Songs live in this folder on the Pi (MP3s are not in the repo).
  // start  = seconds to skip at the beginning
  // fadeIn = seconds to ramp the volume up from silence, starting at "start"
  // end    = seconds (from the start of the file) to stop at; trims a silent tail (optional)
  // fadeOut= seconds of fade-out ending at "end" (optional)
  // gain   = dB adjustment (optional; positive = louder, no peak limiting, keep it small)
  // animation = the scene that plays with it: "bus" (default), "rainbow", "spider" or "head"
  //
  // A tap shows one button per scene (in the order listed here); tapping a button plays a
  // song for that scene. A Spotify song has "spotify" (Share > Copy Song Link) instead of
  // "file". start/end work for Spotify songs; fadeIn, fadeOut and gain do not.
  "songs": [
    { "file": "wheels-on-the-bus.mp3", "start": 6.5, "fadeIn": 1.5, "end": 86, "fadeOut": 1 },

    // Ms. Rachel, "I Love a Rainbow"
    { "spotify": "https://open.spotify.com/track/3bblDd2pNGaTSWGOT6lf3y", "animation": "rainbow" },

    // "Itsy Bitsy Spider"
    { "spotify": "https://open.spotify.com/track/2t03vqSeWEX0HjtdozYSpr", "animation": "spider" },

    // The Wiggles, "Head, Shoulders, Knees And Toes"
    { "spotify": "https://open.spotify.com/track/7zua2xKHb2xX9g5KBkQROb", "animation": "head" }
  ],

  // Spotify songs are played by Spotify Soloist on the Pi, controlled over its local
  // WebSocket API (its --ws address). volume: 1-100 set before each play, 0 = leave alone.
  "spotify": {
    "soloist": "ws://127.0.0.1:9090",
    "volume": 0
  },

  // Three plays that all start within 5 minutes => the bus naps for 90 seconds.
  // Tapping during the nap plays the clip (at most once every 20 seconds); holding a finger
  // on the screen for a moment ends the nap early.
  "limit": {
    "plays": 3,
    "spanMinutes": 5,
    "cooldownMinutes": 1.5,
    "comeBackLater": "come-back-soon.mp3",
    "comeBackLaterGain": 1,
    "clipEverySeconds": 20,

    // A tap only counts after this many quiet seconds since the previous tap
    "tapDebounceSeconds": 2
  }
}
