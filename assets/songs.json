{
  // Songs live in this folder on the Pi (MP3s are not in the repo).
  // start  = seconds to skip at the beginning
  // fadeIn = seconds to ramp the volume up from silence, starting at "start"
  // gain   = dB adjustment (optional; positive = louder, no peak limiting, keep it small)
  "songs": [
    { "file": "wheels-on-the-bus.mp3", "start": 6.5, "fadeIn": 1.5 }
  ],

  // Three plays that all start within 5 minutes => the bus naps for 90 seconds.
  // Tapping during the nap plays the clip (at most once every 20 seconds).
  "limit": {
    "plays": 3,
    "spanMinutes": 5,
    "cooldownMinutes": 1.5,
    "comeBackLater": "come-back-soon.mp3",
    "comeBackLaterGain": 1,
    "clipEverySeconds": 20,

    // A tap only counts after this many quiet seconds since the previous tap
    "tapDebounceSeconds": 2
  }
}
