{
  // Songs live in this folder on the Pi (MP3s are not in the repo).
  // start  = seconds to skip at the beginning
  // fadeIn = seconds to ramp the volume up from silence, starting at "start"
  "songs": [
    { "file": "wheels-on-the-bus.mp3", "start": 6.5, "fadeIn": 1.5 }
  ],

  // Three plays that all start within 5 minutes => the bus naps for 10 minutes.
  // Tapping during the nap plays the clip (at most once every 20 seconds).
  "limit": {
    "plays": 3,
    "spanMinutes": 5,
    "cooldownMinutes": 10,
    "comeBackLater": "come-back-soon.mp3",
    "clipEverySeconds": 20
  }
}
